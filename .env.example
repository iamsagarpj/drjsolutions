# Public site URL used for canonical tags, sitemap, and Open Graph.
VITE_SITE_URL=https://www.drjsolutions.in

# Optional contact API. When empty, leads are stored locally until a backend is connected.
VITE_CONTACT_API_URL=

# Google Analytics measurement ID (e.g. G-XXXXXXXX). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# Google Maps. Leave empty to show an address-based placeholder until verified.
VITE_GOOGLE_MAPS_URL=
VITE_GOOGLE_MAPS_EMBED_URL=
VITE_BUSINESS_LATITUDE=
VITE_BUSINESS_LONGITUDE=
