# Public site URL used for canonical tags, sitemap, and Open Graph.
VITE_SITE_URL=https://www.drjsolutions.in

# Optional contact API. When empty, enquiries are emailed to the business
# address in src/config/site.ts (via FormSubmit). Netlify Forms is a backup.
VITE_CONTACT_API_URL=

# Google Analytics measurement ID (e.g. G-XXXXXXXX). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# Google Maps. Defaults to the office address in src/config/site.ts.
# Set these only if you have a verified Place URL or embed src to override.
VITE_GOOGLE_MAPS_URL=
VITE_GOOGLE_MAPS_EMBED_URL=
